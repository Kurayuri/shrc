export HF_ENDPOINT='https://hf-mirror.com'


################################################################
# # venv
alias av='source ./bin/activate'
alias dv='deactivate'


################################################################
# # shell
cdf()
{
    cd "$(dirname "$1")"
}


################################################################
# # ps
px()
{
    shrc run px "$@"
}

alias pxl='px l'
alias pxla='px la'
alias pxr='px r'
alias pxra='px ra'
alias pxil='px -ui l'
alias pxila='px -ui la'
alias pxir='px -ui r'
