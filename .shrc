    alias -g H='| head'
    alias -g T='| tail'
    alias -g G='| grep'
fi


################################################################
# # suffix alias
if [[ -n "$ZSH_VERSION" ]]; then
    alias -s deb="dpkg -i"
    alias -s gz="tar -zxvf"
    alias -s tar="tar -xvf"
    alias -s tgz="tar -zxvf"
    alias -s zip="unzip"
fi


