################################################################
# # shell
cdf()
{
    cd "$(dirname "$1")"
}


################################################################
# # ps
px()
{
    # --- 1. Parse Function-Specific Flags ---
    
    local ps_args="aux"       # Default arguments for ps
    local processed_args=() # To store args after parsing our custom flags
    
    # Pre-parse all arguments to find our custom '-ps' flag
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == "-ps" ]]; then
            if [[ -z "$2" ]]; then
                echo "Error: -ps option requires arguments (e.g., 'auxww')." >&2
                return 1
            fi
            ps_args="$2"
            shift 2 # Consume -ps and its value
        else
            # Not our -ps flag, add it to the list for later processing
            processed_args+=("$1")
            shift 1
        fi
    done

    # Restore the remaining arguments ($1, $2, etc.) for the next parsing stage
    set -- "${processed_args[@]}"

    # --- 2. Parse User Filters ---
    
    local user_pattern=".*" # Default: Match all users
    local current_user="$USER"

    # Check for special user flags (must be the first remaining argument)
    # Use "==" for exact string match
    if [[ "$1" == "-u" || "$1" == "-ur" || "$1" == "-ui" || "$1" == "-up" ]]; then
        case "$1" in
            -u)
                # -u <username>
                if [ -z "$2" ]; then
                    echo "Error: -u option requires a username." >&2
                    echo "Usage: px [-ps ps_args] [-u user | -ur | -ui | -up] [r|ra|l|la] [search_string]" >&2
                    return 1
                fi
                # Match this specific user
                user_pattern="^$2$"
                shift 2 # Consume flag and argument
                ;;
            -ur)
                # -u root
                user_pattern="^root$"
                shift 1 # Consume flag
                ;;
            -ui)
                # -u $USER
                user_pattern="^${current_user}$"
                shift 1 # Consume flag
                ;;
            -up)
                # -u root AND -u $USER
                if [ "$current_user" = "root" ]; then
                    # If user is already root, just match root
                    user_pattern="^root$"
                else
                    # Match root OR the current user
                    user_pattern="^(root|${current_user})$"
                fi
                shift 1 # Consume flag
                ;;
        esac
    fi

    # --- 3. Parse Positional Mode/Search Arguments ---
    
    local stat_pattern=".*"      # Default: Match any process state
    local cmd_pattern=".*"       # Default: Match any command string
    local search_type="prefix"     # "prefix" (^...) or "contains" (.*...*)
    local search_scope="col11"   # "col11" (command) or "full" (all args)
    local search_string=""

    # Handle mode/search arguments
    # $# reflects args remaining after -ps and user flags were processed
    if [ $# -gt 0 ]; then
        case "$1" in
            l)
                stat_pattern="^[RSD]"
                search_type="prefix"
                search_scope="col11"
                ;;
            la)
                stat_pattern="^[RSD]"
                search_type="contains"
                search_scope="full"
                ;;
            r)
                stat_pattern="^[R]"
                search_type="prefix"
                search_scope="col11"
                ;;
            ra)
                stat_pattern="^[R]"
                search_type="contains"
                search_scope="full"
                ;;
            *)
                echo "Error: Unknown argument '$1'" >&2
                echo "Usage: px [-ps ps_args] [-u user | -ur | -ui | -up] [r|ra|l|la] [search_string]" >&2
                return 1
                ;;
        esac
        shift # Consume the mode argument (l, la, r, ra)

        if [ $# -gt 0 ]; then
            # If a second argument (search string) exists
            search_string="$1"
            
            # [Safety] Create a regex like "[s]shd" to avoid matching the awk process itself
            local first_char="${search_string:0:1}"
            local rest_chars="${search_string:1}"
            local safe_search_pattern="[${first_char}]${rest_chars}"
            
            if [ "$search_type" = "prefix" ]; then
                cmd_pattern="^${safe_search_pattern}"
            else
                cmd_pattern="${safe_search_pattern}"
            fi
            
            # We don't shift here, as there are no more arguments
        fi
    fi
    
    # --- 4. Execute ps and awk ---
    
    # awk script to filter processes
    local awk_script='
        # 1. Always print the header
        NR == 1 { print; next }

        # 2. Filter by user (col 1) using the user_regex variable
        # (Optimization: skip check if regex is ".*")
        (user_regex != ".*" && $1 !~ user_regex) { next }

        # 3. Filter by state (col 8) using the stat_regex variable
        ($8 ~ stat_regex) {
            
            # 4. Filter by command string (col 11+) based on the scope
            if (scope == "col11") {
                # "col11" scope: check only the command name ($11)
                if ($11 ~ cmd_regex) {
                    print
                }
            } else {
                # "full" scope: rebuild the full command string from col 11 to the end
                cmd = ""
                for (i = 11; i <= NF; i++) {
                    cmd = cmd $i " "
                }
                
                # Check the full command string
                if (cmd ~ cmd_regex) {
                    print
                }
            }
        }
    '
  
    # Pass shell variables to awk and execute
    # We use `command ps $ps_args` so that $ps_args (e.g., "aux --forest")
    # is correctly word-split by the shell into multiple arguments for ps.
    command ps $ps_args | awk -v user_regex="$user_pattern" \
                              -v stat_regex="$stat_pattern" \
                              -v cmd_regex="$cmd_pattern" \
                              -v scope="$search_scope" \
                              "$awk_script"
}

alias pxl='px l'
alias pxla='px la'
alias pxr='px r'
alias pxra='px ra'
alias pxil='px -ui l'
alias pxila='px -ui la'
alias pxir='px -ui r'
alias pxira='px -ui ra'


################################################################
# # ssh
tscp()
{
    # tar scp: scp stream transfer with tar, speeding up dummy files scp
    # --------------------------------------------------------------------------
    # Helper function: Executes a command pipeline with retry logic.
    #
    # Arguments:
    #   $1: The first command in the pipeline (string). This command's stderr
    #       is monitored for the "file changed" message.
    #   $2: The second command in the pipeline (string).
    #   $3: A context message for logging, e.g., "Local file" or "Remote file".
    #   $4: The maximum number of retry attempts.
    # --------------------------------------------------------------------------
    local tscp_help="Usage: tscp [-z] [-1] <local_src> <remote> <remote_dst>
       tscp -r [-z] [-1] <remote> <remote_src> <local_dst>
Options:
     -z : Use gzip compression for the transfer.
     -1 : Disable retries (only attempt once).
     -r : Pull mode (remote to local). Without this flag, tscp operates in push mode (local to remote)."

    _tscp_execute() {
        local cmd1="$1"
        local cmd2="$2"
        local context_msg="$3"
        local max_retries="$4"

        for (( attempt=1; attempt<=max_retries; attempt++ )); do
            local temp_err_file
            temp_err_file=$(mktemp)
            
            # Execute the pipeline.
            # A { ...; } group is used to ensure the stderr redirection applies
            # to the command executed by eval, not to eval itself.
            (set -o pipefail; { eval "$cmd1"; } 2> "$temp_err_file" | eval "$cmd2")
            local pipe_status=$?

            # Check for the specific "file changed" warning.
            if grep -q "file changed as we read it" "$temp_err_file"; then
                # If this was the last attempt, report failure.
                if (( attempt >= max_retries )); then
                    echo "tscp: ${context_msg} changed, max attempts (${max_retries}) reached. Aborting." >&2
                    cat "$temp_err_file" >&2
                    rm -f "$temp_err_file"
                    return 1
                else
                    # Otherwise, print a retry message and try again.
                    echo "tscp: ${context_msg} changed, retrying... (${attempt}/${max_retries})" >&2
                    rm -f "$temp_err_file"
                    sleep 1
                    continue
                fi
            fi

            # If a different, non-recoverable error occurred, fail immediately.
            if [[ $pipe_status -ne 0 ]]; then
                echo "tscp: Transfer failed with a non-recoverable error." >&2
                cat "$temp_err_file" >&2
                rm -f "$temp_err_file"
                return $pipe_status
            fi
            
            # If we reach here, the command was successful.
            rm -f "$temp_err_file"
            return 0 # Success
        done
        
        # This line should only be reached if the loop condition fails unexpectedly.
        return 1
    }

    # --------------------------------------------------------------------------
    # Main function logic
    # --------------------------------------------------------------------------
    local OPTIND
    local use_compression=false
    local pull_mode=false
    local no_retry=false
    local tar_opts_create="cf"
    local tar_opts_extract="xf"

    # Process command-line options.
    while getopts "zr1" opt; do
        case $opt in
            z) use_compression=true; tar_opts_create="czf"; tar_opts_extract="xzf" ;;
            r) pull_mode=true ;;
            1) no_retry=true ;;
            \?) echo "Invalid option: -$OPTARG" >&2; return 1 ;;
        esac
    done
    shift $((OPTIND-1))

    # Set max_retries to 1 if the -1 flag is present, otherwise default to 5.
    local max_retries=5
    if [ "$no_retry" = true ]; then
        max_retries=1
    fi

    if [ "$pull_mode" = true ]; then
        # Pull mode: remote -> local
        local remote=$1 src=$2 dst=$3
        if [ -z "$remote" ] || [ -z "$src" ] || [ -z "$dst" ]; then
            echo $tscp_help
            return 1
        fi
        
        # Define the commands for pull mode.
        local cmd1="ssh '$remote' \"tar $tar_opts_create - -C '$(dirname "$src")' '$(basename "$src")'\""
        local cmd2="tar '$tar_opts_extract' - -C '$dst'"

        # Execute using the helper function.
        _tscp_execute "$cmd1" "$cmd2" "Remote file" "$max_retries"
    else
        # Push mode: local -> remote
        local src=$1 remote=$2 dst=$3
        if [ -z "$src" ] || [ -z "$remote" ] || [ -z "$dst" ]; then
            echo $tscp_help
            return 1
        fi
        
        # Define the commands for push mode.
        local cmd1="tar '$tar_opts_create' - '$src'"
        local cmd2="ssh '$remote' \"tar '$tar_opts_extract' - -C '$dst'\""
        
        # Execute using the helper function.
        _tscp_execute "$cmd1" "$cmd2" "Local file" "$max_retries"
    fi
}


################################################################
# # Proxy
# export host_ip=$(cat /etc/resolv.conf |grep "nameserver"|head -1 |cut -f 2 -d " ")

_set_proxy()
{   
    if [ $# = 2 ]; then
        # echo "Setting proxy to $1 and no_proxy to $2"
        export http_proxy="$1" https_proxy="$1" ftp_proxy="$1" all_proxy="$1" no_proxy="$2"
        export HTTP_PROXY="$1" HTTPS_PROXY="$1" FTP_PROXY="$1" ALL_PROXY="$1" NO_PROXY="$2"
    else
        echo "Usage: _set_proxy <proxy_url> <no_proxy_url>"
        return 1
    fi
}

_unset_proxy()
{
    unset http_proxy https_proxy ftp_proxy all_proxy no_proxy
    unset HTTP_PROXY HTTPS_PROXY FTP_PROXY ALL_PROXY NO_PROXY
}

proxy()
{
    local ip="localhost"
    local port=7890
    local protocol="http"
    local proxy_url=""
    local no_proxy_url="localhost,127.0.0.1,::1"

    local proxy_args=()
    local cmd_args=()
    local found_delimiter=0

    _proxy_help()
    {
        echo "Set proxy environment variables in the current shell."
        echo "Usage:"
        echo "  proxy [<ip> [<port> [<protocol>]]]"
        echo "  proxy [<url>]"
        echo "  proxy [proxy-options] -- <command> [args...]"
        echo "  proxy -h"
    }

    # Split arguments around --
    while [ $# -gt 0 ]; do
        if [ "$1" = "--" ]; then
            found_delimiter=1
            shift
            cmd_args=("$@")
            break
        fi

        proxy_args+=("$1")
        shift
    done

    set -- "${proxy_args[@]}"

    if [ "${1:-}" = "-h" ]; then
        _proxy_help
        return 0
    fi

    case $# in
        0)  proxy_url="${PROXY_URL:-}" ;;
        1)  case "$1" in
                *://*) proxy_url="$1" ;;
                *)     ip="$1" ;;
            esac ;;
        2)  ip="$1" ; port="$2" ;;
        3)  ip="$1" ; port="$2"; protocol="$3" ;;
        *)  _proxy_help >&2
            return 2 ;;
    esac

    if [ -z "$proxy_url" ]; then
        proxy_url="${protocol}://${ip}:${port}"
    fi

    if [ "$found_delimiter" -eq 1 ]; then
        if [ ${#cmd_args[@]} -eq 0 ]; then
            echo "proxy: no command specified after --" >&2
            return 2
        fi
        (
            _set_proxy "$proxy_url" "$no_proxy_url" && _shrc_eval "${cmd_args[@]}"
        )
    else
        _set_proxy "$proxy_url" "$no_proxy_url"
    fi
}

alias deproxy="_set_proxy '' ''"

alias unproxy='_unset_proxy'

# proxy

################################################################
# # network
alias ic="ifconfig"

ns()
{
    local OPTIND=1 opt protocol="" listening=""

    while getopts ":tul" opt; do
        case "$opt" in
            t|u) protocol="$opt" ;;
            l) listening=" LISTEN " ;;
            h) echo "Usage: ns [-t|-u] [-l] [<pattern>]" >&2; return 1 ;;
            *) return 1 ;;
        esac
    done
    shift $((OPTIND - 1))

    command netstat "-anp${protocol}" | grep -e "$listening" | grep -e "${1:-}" | grep --color=auto -e "$listening" -e "${1:-}"
}

alias nst='ns -t'
alias nsu='ns -u'
alias nsl='ns -l'

alias tgit="ssh -vT git@github.com"
alias tnet="ping -c 4 www.jd.com"
alias tweb="curl www.jd.com"
alias tprx="curl www.google.com"


################################################################
# # codex
cx()
{
    if [ "$1" = r ]; then
        command codex resume "${@:2}"
    else 
        command codex "$@"
    fi
}

ccx()
{
    proxy -- cx "$@"
}

################################################################
# # tmux
tx()
{
    if [ "$1" = a ]; then
        command tmux attach
    elif [ "$1" = at ]; then
        command tmux attach -t "${@:2}"
    elif [ "$1" = cl  ]; then
        command tmux clear-history
    elif [ "$1" = cls ]; then
        command clear
        command tmux clear-history
    elif [ "$1" = l ]; then 
        command tmux ls "${@:2}"
    elif [ "$1" = n ]; then 
        command tmux
    elif [ "$1" = nn ]; then 
        command tmux new -s "${@:2}"
    elif [ "$1" = rm ]; then 
        command tmux kill-session -t "${@:2}"
    elif [ "$1" = rma ]; then 
        command tmux kill-session -a "${@:2}"
    elif [ "$1" = s ]; then 
        if [ $# = 1 ]; then
            command tmux capture-pane -pS - > "tmux.log"
        elif [ $# = 2 ]; then
            command tmux capture-pane -pS - > "$2"
        fi
    else
        command tmux "$@"
    fi
}


################################################################\
# # docker
dk()
{
    if [ "$1" = l ]; then 
        command docker image list "${@:2}"
    elif [ "$1" = n ]; then
        command docker create "${@:2}"
    elif [ "$1" = nn ]; then
        command docker create --name "${@:2}"
    elif [ "$1" = nnh ]; then
        command docker create --name "${@:2}" tail -f /dev/null
    elif [ "$1" = r ]; then
        command docker run "${@:2}"
    elif [ "$1" = rn ]; then
        command docker run --name "${@:2}"
    elif [ "$1" = rnh ]; then
        command docker run --name "${@:2}" tail -f /dev/null
    elif [ "$1" = p ]; then 
        command docker ps "${@:2}"
    elif [ "$1" = pa ]; then 
        command docker ps -a "${@:2}"
    elif [ "$1" = sa ]; then
        command docker start "${@:2}"
    elif [ "$1" = sat ]; then
        command docker start "$2" && docker exec -it "${@:2}" 
    elif [ "$1" = sab ]; then
        command docker start "${@:2}" && docker exec -it "${@:2}" bash
    elif [ "$1" = saz ]; then
        command docker start "${@:2}" && docker exec -it "${@:2}" zsh
    elif [ "$1" = sp ]; then
        command docker stop "${@:2}"
    elif [ "$1" = rs ]; then
        command docker restart "${@:2}"
    elif [ "$1" = x ]; then
        command docker exec "${@:2}"
    elif [ "$1" = xt ]; then
        command docker exec -it "${@:2}"
    elif [ "$1" = xb ]; then
        command docker exec -it "${@:2}" bash
    elif [ "$1" = xz ]; then
        command docker exec -it "${@:2}" zsh
    elif [ "$1" = c ]; then
        command docker context "${@:2}"
    elif [ "$1" = cn ]; then
        command docker context create "${@:2}"
    elif [ "$1" = crm ]; then
        command docker context rm "${@:2}"
    elif [ "$1" = cl ]; then
        command docker context list "${@:2}"
    elif [ "$1" = cu ]; then
        command docker context use "${@:2}"
    elif [ "$1" = cud ]; then
        command docker context use default
    elif [ "$1" = cc ]; then
        command docker context show "${@:2}"
    elif [ "$1" = i ]; then
        command docker info "${@:2}"
    else
        command docker "$@"
    fi
}


################################################################
# # python
pi()
{
    if [ "$1" = a ]; then
        command tmux attach
    elif [ "$1" = i ]; then 
        command pip install "${@:2}"
    elif [ "$1" = iv ]; then 
        command uv pip install "${@:2}"
    elif [ "$1" = n ]; then 
        command pip install "${@:2}"
    elif [ "$1" = rm ]; then 
        command pip uninstall "${@:2}"
    elif [ "$1" = l ]; then 
        command pip list "${@:2}"
    else
        command pip "$@"
    fi
}

alias py='python'
alias ipy='ipython'
alias piv='uv pip install'


################################################################
# # anaconda
if [ -z "${CONDA_HOME}" ]; then
    export CONDA_HOME="$APP_HOME/anaconda3"
fi

_conda_fix_environments()
{   
    # write all conda env names to $HOME/.conda/environments.txt
    # not startswith # and not empty line
    # print the last column
    conda env list | grep -v '^#' | grep -v '^$' | awk '{print $NF}' > $HOME/.conda/environments.txt
}

cni()
{
    __conda_setup="$('$CONDA_HOME/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "$CONDA_HOME/etc/profile.d/conda.sh" ]; then
            . "$CONDA_HOME/etc/profile.d/conda.sh"
        else
            export PATH="$CONDA_HOME/bin:$PATH"
        fi
    fi
    unset __conda_setup
}

cn()
{   if [ "$1" = av ]; then
        conda activate "${@:2}"
    elif [ "$1" = dv ]; then
        conda deactivate
    elif [ "$1" = l ]; then
        command conda env list
    elif [ "$1" = n ]; then
        command conda create "${@:2}"
    elif [ "$1" = nn ]; then
        command conda create -n "$2" "${@:3}" python
    elif [ "$1" = nnv ]; then
        command conda create -n "$2" "${@:3}" python conda-forge::uv
    elif [ "$1" = nnp ]; then
        command conda create -n "$2" "${@:4}" python="$3"
    elif [ "$1" = nnpv ]; then
        command conda create -n "$2" "${@:4}" python="$3" conda-forge::uv
    elif [ "$1" = rm ]; then
        command conda env remove -n "${@:2}"
    elif [ "$1" = fx ]; then
        _conda_fix_environments
    else
        command conda "$@"
    fi
}

alias cav='cn av'
alias cdv='cn dv'

cni


################################################################
# # sudo
sudox()
{
    if [ $# -eq 0 ]; then
        echo "Usage: sudox <command> [args...]" >&2
        return 1
    fi
  
    sudo bash -c "shopt -s expand_aliases;
        source \"$SHRC_PATH\";eval \"\$@\"
    " "sudox" "$@"
}


################################################################
# # service
svc()
{
    _svc_list_i()
    {
        find ~/.config/systemd/user -maxdepth 1 -type f -printf '%f\n' | grep -e "${1:-}"
        # find ~/.config/systemd/user -maxdepth 1 -type f -printf '%f\n' | grep -e "${1:-}" | sed 's/\.service$//'
    }

    if [ "$1" = l ]; then
        command systemctl list-units --no-pager --type=service --all "${@:2}"
    elif [ "$1" = lu ]; then
        command systemctl list-units --no-pager --type=service --all --user "${@:2}"
    elif [ "$1" = li ]; then
        _svc_list_i
    elif [ "$1" = sa ]; then
        command systemctl start "${@:2}"
    elif [ "$1" = sp ]; then
        command systemctl stop "${@:2}"
    elif [ "$1" = rs ]; then
        command systemctl restart "${@:2}"
    elif [ "$1" = p ]; then
        command systemctl status --no-pager "${@:2}"
    elif [ "$1" = pu ]; then
        command systemctl status --no-pager --user "${@:2}"
    elif [ "$1" = pi ]; then
        command systemctl status --no-pager --user $(_svc_list_i $2) "${@:3}"
    else
        command systemctl "$@"
    fi
}


################################################################
# # find file by name precisely
ff()
{   
    if [ $# = 0 ]; then
        echo "Usage: ff [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command find . -name $1 2> /dev/null
    else
        command find $1 -name $2 2> /dev/null
    fi
}
# # find file by name roughly
ffa()
{   
    if [ $# = 0 ]; then
        echo "Usage: ffa [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command find . -iname \*$1\* 2> /dev/null
    else
        command find $1 -iname \*$2\* 2> /dev/null
    fi
}
# # find text of word
fx()
{  
    if [ $# = 0 ]; then
        echo "Usage: fx [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command grep -rnw . -e $1 --color=auto
    else
        command grep -rnw $1 -e $2 --color=auto ${@:3}
    fi
    
}
# # find text of all
fxa() 
{
    if [ $# = 0 ]; then
        echo "Usage: fxa [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command grep -rni . -e $1 --color=auto
    else
        command grep -rni $1 -e $2 --color=auto ${@:3}
    fi
}


################################################################
# # function
contains() {
    string="$1"
    substring="$2"
    if test "${string#*$substring}" != "$string"
    then
        return 0 
    else
        return 1
    fi
}

_shrc_eval()
{
    # executes a command just like in the shell, but used for shell inner call

    if [ $# -eq 0 ]; then
        return 0
    fi

    local cmd=""

    if [ -n "${BASH_VERSION:-}" ]; then
        # Bash: %q encode each argument for shell evaluation
        local expand_aliases_was_set=0

        shopt -q expand_aliases && expand_aliases_was_set=1
        shopt -s expand_aliases

        printf -v cmd '%q ' "$@"
        eval "$cmd"
        local status=$?

        if [ "$expand_aliases_was_set" -eq 0 ]; then
            shopt -u expand_aliases
        fi

        return "$status"

    elif [ -n "${ZSH_VERSION:-}" ]; then
        # Zsh: (q) encode each argument for shell evaluation, and (j: :) join them with spaces
        local -a eval_args
        eval_args=("$@")

        cmd=${(j: :)${(q)eval_args}}
        eval "$cmd"
        return $?

    else
        echo "_shrc_eval: unsupported shell" >&2
        return 2
    fi
}

################################################################
# # settings
ulimit -n 65536


################################################################
# # shrc
_shrc_SHELL_rc_path()
{
    echo "${HOME}/."$(basename $SHELL)"rc"
}

_shrc_SHELL_history_path()
{
    echo "${HOME}/."$(basename $SHELL)"_history"
}

# clear history
_shrc_SHELL_clear_history()
{   
    echo "Clear history: $(_shrc_SHELL_history_path)"
    command rm $(_shrc_SHELL_history_path)
}

# # source .shrc
_shrc_source_shrc()
{   
    command echo "Current shell: $SHELL"
    . $(_shrc_SHELL_rc_path)
}

# # update .shrc
_shrc_update_shrc()
{
    command curl -fSL https://gitee.com/kurayuri/shrc/raw/main/.shrc -o ${HOME}/.shrc_new
    if [ $? = 0 ]; then
        unalias -a          # avoid alias conflict
        . ${HOME}/.shrc_new
        if [ $? = 0 ]; then
            command rm $SHRC_PATH
            command mv ${HOME}/.shrc_new $SHRC_PATH
        else
            command rm ${HOME}/.shrc_new
        fi
    else
        command rm ${HOME}/.shrc_new
    fi
    _shrc_source_shrc
}

# # edit .shrc
_shrc_edit_shrc()
{
    vim $SHRC_PATH
}

# # view .shrc
_shrc_view_shrc()
{
    command cat $SHRC_PATH
} 

_shrc_update_script()
{
    if [ $# = 0 ]; then
        echo "Usage: ush <script_name>"
    else
        command curl -fsSL https://gitee.com/kurayuri/scripts/raw/main/$1 -o $SHRC_SCRIPTS_HOME/$1.sh
        if [ $? = 0 ]; then
            command chmod +x $1.sh
        fi
    fi
}

_shrc_run_script()
{
    # TODO
    if [ $# = 0 ]; then
        echo "Usage: ush <script_name>"
    else
        command $SHRC_SCRIPTS_HOME/$1.sh
    fi
}

shrc()
{
    if [ $# = 0 ]; then
        echo "Usage: shrc <script_name>"
        return
    fi
    if [ "$1" = update ]; then 
        _shrc_update_shrc ${@:2}
    elif [ "$1" = source ]; then
        _shrc_source_shrc ${@:2}
    elif [ "$1" = edit ]; then
        _shrc_edit_shrc ${@:2}
    elif [ "$1" = view ]; then
        _shrc_view_shrc ${@:2}
    elif [ "$1" = install ]; then
        _shrc_update_script ${@:2}
    elif [ "$1" = run ]; then
        _shrc_update_script ${@:2}
    elif [ "$1" = clear ]; then
        _shrc_SHELL_clear_history ${@:2}
    else
        echo "Unknown command: $1"
        echo "Usage: shrc <command> [<args>]"
        echo "Available commands: source, update, edit, view, install, run, clear"
    fi    
}



alias src='shrc source'
alias urc='shrc update'
alias erc='shrc edit'
alias vrc='shrc view'
alias ish='shrc install'
alias rsh='shrc run'
alias csh='shrc clear'
################################################################