################################################################
# # Command Naming Standard
# n     : Create new            | sa    : Start
## n    : with name             

# rm    : Remove                | sp    : Stop
##  a   : all

# l     : List                  | p     : Process Status
## a    : all

# x     : Execute


################################################################
# # Shortcut
alias cls='clear'

alias du0="du -s   -h | sort -h"
alias du1="du -d 1 -h | sort -h"

alias h="history"

alias py='python'

alias wa='watch -n 0.1'

alias runner="ps aux | awk '{print \$1}' | sort | uniq"

################################################################
# # global alias
alias -g H='| head'
alias -g T='| tail'
alias -g G='| grep'


################################################################
# # suffix alias
alias -s deb="dpkg -i"
alias -s gz="tar -zxvf"
alias -s tgz="tar -zxvf"
alias -s zip="unzip"


################################################################
# # venv
alias av='source ./bin/activate'
alias dv='deactivate'


################################################################
# # Proxy
# export host_ip=$(cat /etc/resolv.conf |grep "nameserver"|head -1 |cut -f 2 -d " ")
export host_ip="localhost"
alias proxy="export all_proxy=http://$host_ip:7890 http_proxy=http://$host_ip:7890 https_proxy=http://$host_ip:7890 socks_proxy=http://$host_ip:7890"
alias unproxy='unset all_proxy http_proxy https_proxy socks_proxy'
# proxy

################################################################
# # network
alias ic="ifconfig"

ns()
{   
    if [ $# = 0 ]; then
        command netstat -anp
    elif [ $# = 1 ]; then
        command netstat -anp | grep $1
    fi
}


nst()
{   
    if [ $# = 0 ]; then
        command netstat -anpt
    elif [ $# = 1 ]; then
        command netstat -anpt | grep $1
    fi
}

nsu()
{   
    if [ $# = 0 ]; then
        command netstat -anpu
    elif [ $# = 1 ]; then
        command netstat -anpu | grep $1
    fi
}

alias tgit="ssh -vT git@github.com"
alias tprx="curl www.google.com"
alias tnet="ping -c 4 jd.com"

################################################################
# # ssh-agent
ssa()
{
    eval "$(ssh-agent -s)"
    cd ~/.ssh
    ssh-add *id*
    cd ~
}
# ssa


################################################################
# # tmux
tx()
{
    if [ "$1" = a ]; then
        command tmux attach
    elif [ "$1" = at ]; then
        command tmux attach -t "${@:2}"
    elif [ "$1" = cl  ]; then
        command tmux clear-history
    elif [ "$1" = cls ]; then
        command clear
        command tmux clear-history
    elif [ "$1" = l ]; then 
        command tmux ls "${@:2}"
    elif [ "$1" = n ]; then 
        command tmux
    elif [ "$1" = nn ]; then 
        command tmux new -s "${@:2}"
    elif [ "$1" = rm ]; then 
        command tmux kill-session -t "${@:2}"
    elif [ "$1" = rma ]; then 
        command tmux kill-session -a "${@:2}"
    elif [ "$1" = s ]; then 
        if [ $# = 1 ]; then
            command tmux capture-pane -pS - > "tmux.log"
        elif [ $# = 2 ]; then
            command tmux capture-pane -pS - > "$2"
        fi
    else
        command tmux "$@"
    fi
}

TMUX_CONF='set -g history-limit 1048576
bind C-l send-keys C-l \; clear-history
bind C-s capture-pane -S -  \; save-buffer tmux.log'
echo $TMUX_CONF > $HOME/.tmux.conf


################################################################\
# # docker
dk()
{

    if [ "$1" = l ]; then 
        command docker image list "${@:2}"
    elif [ "$1" = n ]; then
        command docker create "${@:2}"
    elif [ "$1" = nn ]; then
        command docker create --name "${@:2}"
    elif [ "$1" = nnx ]; then
        command docker create --name "${@:2}" tail -f /dev/null
    elif [ "$1" = p ]; then 
        command docker ps "${@:2}"
    elif [ "$1" = pa ]; then 
        command docker ps -a "${@:2}"
    elif [ "$1" = sa ]; then
        command docker start "${@:2}"
    elif [ "$1" = sat ]; then
        command docker start "$2" && docker exec -it "${@:2}" 
    elif [ "$1" = sab ]; then
        command docker start "${@:2}" && docker exec -it "${@:2}" bash
    elif [ "$1" = sp ]; then
        command docker stop "${@:2}"
    elif [ "$1" = x ]; then
        command docker exec "${@:2}"
    elif [ "$1" = xt ]; then
        command docker exec -it "${@:2}"
    elif [ "$1" = xb ]; then
        command docker exec -it "${@:2}" bash
    else
        command docker "$@"
    fi
}


################################################################
# # anaconda
cni()
{
    __conda_setup="$('$CONDA_HOME/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "$CONDA_HOME/etc/profile.d/conda.sh" ]; then
            . "$CONDA_HOME/etc/profile.d/conda.sh"
        else
            export PATH="$CONDA_HOME/bin:$PATH"
        fi
    fi
    unset __conda_setup
}

cn()
{   if [ "$1" = av ]; then
        conda activate "${@:2}"
    elif [ "$1" = dv ]; then
        conda deactivate
    elif [ "$1" = l ]; then
        command conda env list
    elif [ "$1" = n ]; then
        command conda create "${@:2}"
    elif [ "$1" = nn ]; then
        command conda create -n "$2" "${@:3}" python
    elif [ "$1" = nnp ]; then
        command conda create -n "$2" "${@:4}" python="$3"
    elif [ "$1" = rm ]; then
        command conda env remove -n "${@:2}"
    else
        command conda "$@"
    fi
}

alias cav='cn av'
alias cdv='cn dv'


################################################################
# # find file by name precisely
ff()
{   
    if [ $# = 0 ]; then
    elif [ $# = 1 ]; then
        command find . -name $1 2> /dev/null
    else
        command find $1 -name $2 2> /dev/null
    fi
}
# # find file by name roughly
ffa()
{   
    if [ $# = 0 ]; then
    elif [ $# = 1 ]; then
        command find . -iname \*$1\* 2> /dev/null
    else
        command find $1 -iname \*$2\* 2> /dev/null
    fi
}
# # find text of word
fx()
{  
    if [ $# = 0 ]; then
    elif [ $# = 1 ]; then
        command grep -rnw . -e $1 --color=auto
    else
        command grep -rnw $1 -e $2 --color=auto ${@:3}
    fi
    
}
# # find text of all
fxa() 
{
    if [ $# = 0 ]; then
    elif [ $# = 1 ]; then
        command grep -rni . -e $1 --color=auto
    else
        command grep -rni $1 -e $2 --color=auto ${@:3}
    fi
}


################################################################
# # function
contains() {
    string="$1"
    substring="$2"
    if test "${string#*$substring}" != "$string"
    then
        return 0 
    else
        return 1
    fi
}


################################################################
# # source .shrc
src()
{
    if contains $SHELL zsh; then
        command echo zsh
        . ~/.zshrc
    elif contains $SHELL bash; then
        command echo bash
        . ~/.bashrc
    fi
}

# # update .shrc
urc()
{
    command wget https://gitee.com/kurayuri/shrc/raw/main/.shrc -O ~/.shrc_new
    if [ $? = 0 ]; then
        . ~/.shrc_new
        if [ $? = 0 ]; then
            command rm ~/.shrc
            command mv ~/.shrc_new ~/.shrc
        else
            command rm ~/.shrc_new
        fi
    else
        command rm ~/.shrc_new
    fi
    src
}
