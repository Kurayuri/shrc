################################################################
# # Proxy
# export host_ip=$(cat /etc/resolv.conf |grep "nameserver"|head -1 |cut -f 2 -d " ")

_set_proxy()
{   
    if [ $# = 2 ]; then
        # echo "Setting proxy to $1 and no_proxy to $2"
        export http_proxy="$1" https_proxy="$1" ftp_proxy="$1" all_proxy="$1" no_proxy="$2"
        export HTTP_PROXY="$1" HTTPS_PROXY="$1" FTP_PROXY="$1" ALL_PROXY="$1" NO_PROXY="$2"
    else
        echo "Usage: _set_proxy <proxy_url> <no_proxy_url>"
        return 1
    fi
}

_unset_proxy()
{
    unset http_proxy https_proxy ftp_proxy all_proxy no_proxy
    unset HTTP_PROXY HTTPS_PROXY FTP_PROXY ALL_PROXY NO_PROXY
}

proxy()
{
    local ip="localhost"
    local port=7890
    local protocol="http"
    local proxy_url=""
    local no_proxy_url="localhost,127.0.0.1,::1"

    local proxy_args=()
    local cmd_args=()
    local found_delimiter=0

    _proxy_help()
    {
        echo "Set proxy environment variables in the current shell."
        echo "Usage:"
        echo "  proxy [<ip> [<port> [<protocol>]]]"
        echo "  proxy [<url>]"
        echo "  proxy [proxy-options] -- <command> [args...]"
        echo "  proxy -h"
    }

    # Split arguments around --
    while [ $# -gt 0 ]; do
        if [ "$1" = "--" ]; then
            found_delimiter=1
            shift
            cmd_args=("$@")
            break
        fi

        proxy_args+=("$1")
        shift
    done

    set -- "${proxy_args[@]}"

    if [ "${1:-}" = "-h" ]; then
        _proxy_help
        return 0
    fi

    case $# in
        0)  proxy_url="${PROXY_URL:-}" ;;
        1)  case "$1" in
                *://*) proxy_url="$1" ;;
                *)     ip="$1" ;;
            esac ;;
        2)  ip="$1" ; port="$2" ;;
        3)  ip="$1" ; port="$2"; protocol="$3" ;;
        *)  _proxy_help >&2
            return 2 ;;
    esac

    if [ -z "$proxy_url" ]; then
        proxy_url="${protocol}://${ip}:${port}"
    fi

    if [ "$found_delimiter" -eq 1 ]; then
        if [ ${#cmd_args[@]} -eq 0 ]; then
            echo "proxy: no command specified after --" >&2
            return 2
        fi
        (
            _set_proxy "$proxy_url" "$no_proxy_url" && _shrc_eval "${cmd_args[@]}"
        )
    else
        _set_proxy "$proxy_url" "$no_proxy_url"
    fi
}

alias deproxy="_set_proxy '' ''"

alias unproxy='_unset_proxy'

# proxy

################################################################
# # network
alias ic="ifconfig"

ns()
{
    local OPTIND=1 opt protocol="" listening=""

    while getopts ":tul" opt; do
        case "$opt" in
            t|u) protocol="$opt" ;;
            l) listening=" LISTEN " ;;
            h) echo "Usage: ns [-t|-u] [-l] [<pattern>]" >&2; return 1 ;;
            *) return 1 ;;
        esac
    done
    shift $((OPTIND - 1))

    command netstat "-anp${protocol}" | grep -e "$listening" | grep -e "${1:-}" | grep --color=auto -e "$listening" -e "${1:-}"
}

alias nst='ns -t'
alias nsu='ns -u'
alias nsl='ns -l'

alias tgit="ssh -vT git@github.com"
alias tnet="ping -c 4 www.jd.com"
alias tweb="curl www.jd.com"
alias tprx="curl www.google.com"


################################################################
# # codex
cx()
{
    if [ "$1" = a ]; then
        command codex archive "${@:2}"
    elif [ "$1" = r ]; then
        command codex resume "${@:2}"
    elif [ "$1" = x ]; then
        command codex exec "${@:2}"
    elif [ "$1" = xe ]; then
        command codex exec --ephemeral "${@:2}"
    else 
        command codex "$@"
    fi
}

ccx()
{
    proxy -- cx "$@"
}

################################################################
# # tmux
tx()
{
    if [ "$1" = a ]; then
        command tmux attach
    elif [ "$1" = at ]; then
        command tmux attach -t "${@:2}"
    elif [ "$1" = cl  ]; then
        command tmux clear-history
    elif [ "$1" = cls ]; then
        command clear
        command tmux clear-history
    elif [ "$1" = l ]; then 
        command tmux ls "${@:2}"
    elif [ "$1" = n ]; then 
        command tmux
    elif [ "$1" = nn ]; then 
        command tmux new -s "${@:2}"
    elif [ "$1" = rm ]; then 
        command tmux kill-session -t "${@:2}"
    elif [ "$1" = rma ]; then 
        command tmux kill-session -a "${@:2}"
    elif [ "$1" = s ]; then 
        if [ $# = 1 ]; then
            command tmux capture-pane -pS - > "tmux.log"
        elif [ $# = 2 ]; then
            command tmux capture-pane -pS - > "$2"
        fi
    else
        command tmux "$@"
    fi
}


################################################################\
# # docker
dk()
{
    if [ "$1" = l ]; then 
        command docker image list "${@:2}"
    elif [ "$1" = n ]; then
        command docker create "${@:2}"
    elif [ "$1" = nn ]; then
        command docker create --name "${@:2}"
    elif [ "$1" = nnh ]; then
        command docker create --name "${@:2}" tail -f /dev/null
    elif [ "$1" = r ]; then
        command docker run "${@:2}"
    elif [ "$1" = rn ]; then
        command docker run --name "${@:2}"
    elif [ "$1" = rnh ]; then
        command docker run --name "${@:2}" tail -f /dev/null
    elif [ "$1" = p ]; then 
        command docker ps "${@:2}"
    elif [ "$1" = pa ]; then 
        command docker ps -a "${@:2}"
    elif [ "$1" = sa ]; then
        command docker start "${@:2}"
    elif [ "$1" = sat ]; then
        command docker start "$2" && docker exec -it "${@:2}" 
    elif [ "$1" = sab ]; then
        command docker start "${@:2}" && docker exec -it "${@:2}" bash
    elif [ "$1" = saz ]; then
        command docker start "${@:2}" && docker exec -it "${@:2}" zsh
    elif [ "$1" = sp ]; then
        command docker stop "${@:2}"
    elif [ "$1" = rs ]; then
        command docker restart "${@:2}"
    elif [ "$1" = x ]; then
        command docker exec "${@:2}"
    elif [ "$1" = xt ]; then
        command docker exec -it "${@:2}"
    elif [ "$1" = xb ]; then
        command docker exec -it "${@:2}" bash
    elif [ "$1" = xz ]; then
        command docker exec -it "${@:2}" zsh
    elif [ "$1" = c ]; then
        command docker context "${@:2}"
    elif [ "$1" = cn ]; then
        command docker context create "${@:2}"
    elif [ "$1" = crm ]; then
        command docker context rm "${@:2}"
    elif [ "$1" = cl ]; then
        command docker context list "${@:2}"
    elif [ "$1" = cu ]; then
        command docker context use "${@:2}"
    elif [ "$1" = cud ]; then
        command docker context use default
    elif [ "$1" = cc ]; then
        command docker context show "${@:2}"
    elif [ "$1" = i ]; then
        command docker info "${@:2}"
    else
        command docker "$@"
    fi
}


################################################################
# # python
pi()
{
    if [ "$1" = a ]; then
        command tmux attach
    elif [ "$1" = i ]; then 
        command pip install "${@:2}"
    elif [ "$1" = iv ]; then 
        command uv pip install "${@:2}"
    elif [ "$1" = n ]; then 
        command pip install "${@:2}"
    elif [ "$1" = rm ]; then 
        command pip uninstall "${@:2}"
    elif [ "$1" = l ]; then 
        command pip list "${@:2}"
    else
        command pip "$@"
    fi
}

alias py='python'
alias ipy='ipython'
alias piv='uv pip install'


################################################################
# # anaconda
if [ -z "${CONDA_HOME}" ]; then
    export CONDA_HOME="$APP_HOME/anaconda3"
fi

_conda_fix_environments()
{   
    # write all conda env names to $HOME/.conda/environments.txt
    # not startswith # and not empty line
    # print the last column
    conda env list | grep -v '^#' | grep -v '^$' | awk '{print $NF}' > $HOME/.conda/environments.txt
}

cni()
{
    __conda_setup="$('$CONDA_HOME/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "$CONDA_HOME/etc/profile.d/conda.sh" ]; then
            . "$CONDA_HOME/etc/profile.d/conda.sh"
        else
            export PATH="$CONDA_HOME/bin:$PATH"
        fi
    fi
    unset __conda_setup
}

cn()
{   if [ "$1" = av ]; then
        conda activate "${@:2}"
    elif [ "$1" = dv ]; then
        conda deactivate
    elif [ "$1" = l ]; then
        command conda env list
    elif [ "$1" = n ]; then
        command conda create "${@:2}"
    elif [ "$1" = nn ]; then
        command conda create -n "$2" "${@:3}" python
    elif [ "$1" = nnv ]; then
        command conda create -n "$2" "${@:3}" python conda-forge::uv
    elif [ "$1" = nnp ]; then
        command conda create -n "$2" "${@:4}" python="$3"
    elif [ "$1" = nnpv ]; then
        command conda create -n "$2" "${@:4}" python="$3" conda-forge::uv
    elif [ "$1" = rm ]; then
        command conda env remove -n "${@:2}"
    elif [ "$1" = fx ]; then
        _conda_fix_environments
    else
        command conda "$@"
    fi
}

alias cav='cn av'
alias cdv='cn dv'

cni


################################################################
# # sudo
sudox()
{
    if [ $# -eq 0 ]; then
        echo "Usage: sudox <command> [args...]" >&2
        return 1
    fi
  
    sudo bash -c "shopt -s expand_aliases;
        source \"$SHRC_PATH\";eval \"\$@\"
    " "sudox" "$@"
}


################################################################
# # service
svc()
{
    shrc run svc "$@"
}


################################################################
# # find file by name precisely
ff()
{   
    if [ $# = 0 ]; then
        echo "Usage: ff [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command find . -name $1 2> /dev/null
    else
        command find $1 -name $2 2> /dev/null
    fi
}
# # find file by name roughly
ffa()
{   
    if [ $# = 0 ]; then
        echo "Usage: ffa [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command find . -iname \*$1\* 2> /dev/null
    else
        command find $1 -iname \*$2\* 2> /dev/null
    fi
}
# # find text of word
fx()
{  
    if [ $# = 0 ]; then
        echo "Usage: fx [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command grep -rnw . -e $1 --color=auto
    else
        command grep -rnw $1 -e $2 --color=auto ${@:3}
    fi
    
}
# # find text of all
fxa() 
{
    if [ $# = 0 ]; then
        echo "Usage: fxa [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command grep -rni . -e $1 --color=auto
    else
        command grep -rni $1 -e $2 --color=auto ${@:3}
    fi
}


################################################################
# # function
contains() {
    string="$1"
    substring="$2"
    if test "${string#*$substring}" != "$string"
    then
        return 0 
    else
        return 1
    fi
}

_shrc_eval()
{
    # executes a command just like in the shell, but used for shell inner call

    if [ $# -eq 0 ]; then
        return 0
    fi

    local cmd=""

    if [ -n "${BASH_VERSION:-}" ]; then
        # Bash: %q encode each argument for shell evaluation
        local expand_aliases_was_set=0

        shopt -q expand_aliases && expand_aliases_was_set=1
        shopt -s expand_aliases

        printf -v cmd '%q ' "$@"
        eval "$cmd"
        local status=$?

        if [ "$expand_aliases_was_set" -eq 0 ]; then
            shopt -u expand_aliases
        fi

        return "$status"

    elif [ -n "${ZSH_VERSION:-}" ]; then
        # Zsh: (q) encode each argument for shell evaluation, and (j: :) join them with spaces
        local -a eval_args
        eval_args=("$@")

        cmd=${(j: :)${(q)eval_args}}
        eval "$cmd"
        return $?

    else
        echo "_shrc_eval: unsupported shell" >&2
        return 2
    fi
}

################################################################
# # settings
ulimit -n 65536


################################################################
# # shrc
_shrc_SHELL_rc_path()
{
    echo "${HOME}/."$(basename $SHELL)"rc"
}

_shrc_SHELL_history_path()
{
    echo "${HOME}/."$(basename $SHELL)"_history"
}

# clear history
_shrc_SHELL_clear_history()
{   
    echo "Clear history: $(_shrc_SHELL_history_path)"
    command rm $(_shrc_SHELL_history_path)
}

# # source .shrc
_shrc_source_shrc()
{   
    command echo "Current shell: $SHELL"
    . $(_shrc_SHELL_rc_path)
}

# # update .shrc
_shrc_update_shrc()
{
    local shrc_new="${HOME}/.shrc_new"

    if ! command curl -fsSL -o "$shrc_new" -- "$SHRC_REPO_RAW_URL/.shrc"; then
        command rm -f -- "$shrc_new"
        return 1
    fi

    unalias -a          # avoid alias conflict
    if ! . "$shrc_new"; then
        command rm -f -- "$shrc_new"
        _shrc_source_shrc
        return 1
    fi

    if ! command mv -f -- "$shrc_new" "$SHRC_PATH"; then
        command rm -f -- "$shrc_new"
        _shrc_source_shrc
        return 1
    fi

    _shrc_source_shrc
}

# # edit .shrc
_shrc_edit_shrc()
{
    vim $SHRC_PATH
}

# # view .shrc
_shrc_view_shrc()
{
    command cat $SHRC_PATH
} 

_shrc_update_script()
{
    if [ $# -ne 1 ]; then
        echo "Usage: ish <script_name>" >&2
        return 2
    fi

    local script_name="$1"
    local script_path=""
    local script_new=""

    if ! _shrc_valid_script_name "$script_name"; then
        echo "ish: invalid script name: $script_name" >&2
        echo "Script names use letters, numbers, underscores, and hyphens without a .sh suffix." >&2
        return 2
    fi

    command mkdir -p -- "$SHRC_SCRIPTS_HOME" || return 1
    script_path="$SHRC_SCRIPTS_HOME/$script_name.sh"
    script_new=$(command mktemp "$script_path.new.XXXXXX") || return 1

    if command curl -fsSL -o "$script_new" -- "$SHRC_REPO_RAW_URL/.shrc_scripts/$script_name.sh" \
        && command chmod +x "$script_new" \
        && command mv -f -- "$script_new" "$script_path"; then
        command echo "Installed: $script_name"
        return 0
    fi

    command rm -f -- "$script_new"
    echo "ish: failed to install script: $script_name" >&2
    return 1
}

_shrc_valid_script_name()
{
    if [ $# -ne 1 ]; then
        return 1
    fi

    case "$1" in
        ""|-a|*.sh|[-_]*|*[!A-Za-z0-9_-]*) return 1 ;;
        *) return 0 ;;
    esac
}

_shrc_update_all_scripts()
{
    local manifest_new=""
    local script_name=""
    local script_count=0
    local -a failed_scripts=()

    command mkdir -p -- "$SHRC_SCRIPTS_HOME" || return 1
    manifest_new=$(command mktemp "$SHRC_SCRIPTS_HOME/.manifest.new.XXXXXX") || return 1

    if ! command curl -fsSL -o "$manifest_new" -- "$SHRC_SCRIPTS_MANIFEST_URL"; then
        command rm -f -- "$manifest_new"
        echo "ish: failed to download script manifest" >&2
        return 1
    fi

    while IFS= read -r script_name || [ -n "$script_name" ]; do
        script_name="${script_name%$'\r'}"
        case "$script_name" in
            ""|\#*) continue ;;
        esac

        script_count=$((script_count + 1))
        if ! _shrc_valid_script_name "$script_name"; then
            echo "ish: invalid script name in manifest: $script_name" >&2
            failed_scripts+=("$script_name")
        elif ! _shrc_update_script "$script_name"; then
            failed_scripts+=("$script_name")
        fi
    done < "$manifest_new"

    command rm -f -- "$manifest_new"

    if [ "$script_count" -eq 0 ]; then
        echo "ish: script manifest contains no entries" >&2
        return 1
    fi

    if [ ${#failed_scripts[@]} -ne 0 ]; then
        echo "ish: failed scripts: ${failed_scripts[*]}" >&2
        return 1
    fi

    return 0
}

_shrc_run_script()
{
    if [ $# -eq 0 ]; then
        echo "Usage: rsh <script_name> [args...]" >&2
        return 2
    fi

    local script_name="$1"
    local script_path=""
    shift

    if ! _shrc_valid_script_name "$script_name"; then
        echo "rsh: invalid script name: $script_name" >&2
        return 2
    fi

    script_path="$SHRC_SCRIPTS_HOME/$script_name.sh"
    if [ ! -f "$script_path" ] || [ ! -r "$script_path" ]; then
        echo "rsh: script is not installed: $script_name" >&2
        echo "Run 'ish $script_name' first." >&2
        return 1
    fi

    command bash "$script_path" "$@"
}

_shrc_usage()
{
    echo "Usage: shrc <command> [args...]"
    echo "Commands:"
    echo "  source                 Reload the current shell rc file"
    echo "  update [-a]            Update .shrc; -a also updates all scripts"
    echo "  edit                   Edit .shrc"
    echo "  view                   View .shrc"
    echo "  install <name>|-a      Install one or all scripts"
    echo "  run <name> [args...]   Run an installed script with Bash"
    echo "  clear                  Clear shell history"
}

shrc()
{
    if [ $# -eq 0 ]; then
        _shrc_usage >&2
        return 2
    fi

    local shrc_command="$1"
    shift

    case "$shrc_command" in
        update)
            if [ $# -eq 0 ]; then
                _shrc_update_shrc
            elif [ $# -eq 1 ] && [ "$1" = "-a" ]; then
                _shrc_update_shrc && _shrc_update_all_scripts
            else
                echo "Usage: urc [-a]" >&2
                return 2
            fi
            ;;
        source)
            if [ $# -ne 0 ]; then
                echo "Usage: src" >&2
                return 2
            fi
            _shrc_source_shrc
            ;;
        edit)
            if [ $# -ne 0 ]; then
                echo "Usage: erc" >&2
                return 2
            fi
            _shrc_edit_shrc
            ;;
        view)
            if [ $# -ne 0 ]; then
                echo "Usage: vrc" >&2
                return 2
            fi
            _shrc_view_shrc
            ;;
        install)
            if [ $# -eq 1 ] && [ "$1" = "-a" ]; then
                _shrc_update_all_scripts
            else
                _shrc_update_script "$@"
            fi
            ;;
        run)
            _shrc_run_script "$@"
            ;;
        clear)
            if [ $# -ne 0 ]; then
                echo "Usage: csh" >&2
                return 2
            fi
            _shrc_SHELL_clear_history
            ;;
        *)
            echo "Unknown command: $shrc_command" >&2
            _shrc_usage >&2
            return 2
            ;;
    esac
}



alias src='shrc source'
alias urc='shrc update'
alias erc='shrc edit'
alias vrc='shrc view'
alias ish='shrc install'
alias rsh='shrc run'
alias csh='shrc clear'
################################################################
