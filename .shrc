################################################################
# # ssh
tscp()
{
    # --------------------------------------------------------------------------
    # Helper function: Executes a command pipeline with retry logic.
    #
    # Arguments:
    #   $1: The first command in the pipeline (string). This command's stderr
    #       is monitored for the "file changed" message.
    #   $2: The second command in the pipeline (string).
    #   $3: A context message for logging, e.g., "Local file" or "Remote file".
    #   $4: The maximum number of retry attempts.
    # --------------------------------------------------------------------------
    _tscp_execute() {
        local cmd1="$1"
        local cmd2="$2"
        local context_msg="$3"
        local max_retries="$4"

        for (( attempt=1; attempt<=max_retries; attempt++ )); do
            local temp_err_file
            temp_err_file=$(mktemp)
            
            # Execute the pipeline.
            # A { ...; } group is used to ensure the stderr redirection applies
            # to the command executed by eval, not to eval itself.
            (set -o pipefail; { eval "$cmd1"; } 2> "$temp_err_file" | eval "$cmd2")
            local pipe_status=$?

            # Check for the specific "file changed" warning.
            if grep -q "file changed as we read it" "$temp_err_file"; then
                # If this was the last attempt, report failure.
                if (( attempt >= max_retries )); then
                    echo "tscp: ${context_msg} changed, max attempts (${max_retries}) reached. Aborting." >&2
                    cat "$temp_err_file" >&2
                    rm -f "$temp_err_file"
                    return 1
                else
                    # Otherwise, print a retry message and try again.
                    echo "tscp: ${context_msg} changed, retrying... (${attempt}/${max_retries})" >&2
                    rm -f "$temp_err_file"
                    sleep 1
                    continue
                fi
            fi

            # If a different, non-recoverable error occurred, fail immediately.
            if [[ $pipe_status -ne 0 ]]; then
                echo "tscp: Transfer failed with a non-recoverable error." >&2
                cat "$temp_err_file" >&2
                rm -f "$temp_err_file"
                return $pipe_status
            fi
            
            # If we reach here, the command was successful.
            rm -f "$temp_err_file"
            return 0 # Success
        done
        
        # This line should only be reached if the loop condition fails unexpectedly.
        return 1
    }

    # --------------------------------------------------------------------------
    # Main function logic
    # --------------------------------------------------------------------------
    local OPTIND
    local use_compression=false
    local pull_mode=false
    local no_retry=false
    local tar_opts_create="cf"
    local tar_opts_extract="xf"

    # Process command-line options.
    while getopts "zr1" opt; do
        case $opt in
            z) use_compression=true; tar_opts_create="czf"; tar_opts_extract="xzf" ;;
            r) pull_mode=true ;;
            1) no_retry=true ;;
            \?) echo "Invalid option: -$OPTARG" >&2; return 1 ;;
        esac
    done
    shift $((OPTIND-1))

    # Set max_retries to 1 if the -1 flag is present, otherwise default to 5.
    local max_retries=5
    if [ "$no_retry" = true ]; then
        max_retries=1
    fi

    if [ "$pull_mode" = true ]; then
        # Pull mode: remote -> local
        local remote=$1 src=$2 dst=$3
        if [ -z "$remote" ] || [ -z "$src" ] || [ -z "$dst" ]; then
            echo "Usage: tscp -r [-z] [-1] <remote> <remote_src> <local_dst>"
            return 1
        fi
        
        # Define the commands for pull mode.
        local cmd1="ssh '$remote' \"tar $tar_opts_create - -C '$(dirname "$src")' '$(basename "$src")'\""
        local cmd2="tar '$tar_opts_extract' - -C '$dst'"

        # Execute using the helper function.
        _tscp_execute "$cmd1" "$cmd2" "Remote file" "$max_retries"
    else
        # Push mode: local -> remote
        local src=$1 remote=$2 dst=$3
        if [ -z "$src" ] || [ -z "$remote" ] || [ -z "$dst" ]; then
            echo "Usage: tscp [-z] [-1] <local_src> <remote> <remote_dst>"
            return 1
        fi
        
        # Define the commands for push mode.
        local cmd1="tar '$tar_opts_create' - '$src'"
        local cmd2="ssh '$remote' \"tar '$tar_opts_extract' - -C '$dst'\""
        
        # Execute using the helper function.
        _tscp_execute "$cmd1" "$cmd2" "Local file" "$max_retries"
    fi
}


################################################################
# # Proxy
# export host_ip=$(cat /etc/resolv.conf |grep "nameserver"|head -1 |cut -f 2 -d " ")

proxy()
{
    local ip="localhost"
    local port=7890
    local protocal="http"
    if [ $# = 1 ]; then
        ip=$1
    elif [ $# = 2 ]; then
        ip=$1
        port=$2
    elif [ $# = 3 ]; then
        ip=$1
        port=$2
        protocal=$3
    fi
    export all_proxy="${protocal}://${ip}:${port}" http_proxy="${protocal}://${ip}:${port}" https_proxy="${protocal}://${ip}:${port}" socks_proxy="${protocal}://${ip}:${port}" no_proxy="localhost,127.0.0.1,::1"
    export ALL_PROXY="${protocal}://${ip}:${port}" HTTP_PROXY="${protocal}://${ip}:${port}" HTTPS_PROXY="${protocal}://${ip}:${port}" SOCKS_PROXY="${protocal}://${ip}:${port}" NO_PROXY="localhost,127.0.0.1,::1"
}
alias unproxy='unset all_proxy http_proxy https_proxy socks_proxy ALL_PROXY HTTP_PROXY HTTPS_PROXY SOCKS_PROXY'
# proxy

################################################################
# # network
alias ic="ifconfig"

ns()
{   
    if [ $# = 0 ]; then
        command netstat -anp
    elif [ $# = 1 ]; then
        command netstat -anp | grep $1
    fi
}


nst()
{   
    if [ $# = 0 ]; then
        command netstat -anpt
    elif [ $# = 1 ]; then
        command netstat -anpt | grep $1
    fi
}

nsu()
{   
    if [ $# = 0 ]; then
        command netstat -anpu
    elif [ $# = 1 ]; then
        command netstat -anpu | grep $1
    fi
}

alias tgit="ssh -vT git@github.com"
alias tnet="ping -c 4 jd.com"
alias tweb="curl jd.com"
alias tprx="curl www.google.com"

################################################################
# # ssh-agent
ssa()
{
    eval "$(ssh-agent -s)"
    cd ${HOME}/.ssh
    ssh-add *id*
    cd ${HOME}
}
# ssa


################################################################
# # tmux
tx()
{
    if [ "$1" = a ]; then
        command tmux attach
    elif [ "$1" = at ]; then
        command tmux attach -t "${@:2}"
    elif [ "$1" = cl  ]; then
        command tmux clear-history
    elif [ "$1" = cls ]; then
        command clear
        command tmux clear-history
    elif [ "$1" = l ]; then 
        command tmux ls "${@:2}"
    elif [ "$1" = n ]; then 
        command tmux
    elif [ "$1" = nn ]; then 
        command tmux new -s "${@:2}"
    elif [ "$1" = rm ]; then 
        command tmux kill-session -t "${@:2}"
    elif [ "$1" = rma ]; then 
        command tmux kill-session -a "${@:2}"
    elif [ "$1" = s ]; then 
        if [ $# = 1 ]; then
            command tmux capture-pane -pS - > "tmux.log"
        elif [ $# = 2 ]; then
            command tmux capture-pane -pS - > "$2"
        fi
    else
        command tmux "$@"
    fi
}

TMUX_CONF='set -g history-limit 1048576
bind C-l send-keys C-l \; clear-history
bind C-s capture-pane -S -  \; save-buffer tmux.log'
echo $TMUX_CONF > $HOME/.tmux.conf


################################################################\
# # docker
dk()
{
    if [ "$1" = l ]; then 
        command docker image list "${@:2}"
    elif [ "$1" = n ]; then
        command docker create "${@:2}"
    elif [ "$1" = nn ]; then
        command docker create --name "${@:2}"
    elif [ "$1" = nnh ]; then
        command docker create --name "${@:2}" tail -f /dev/null
    elif [ "$1" = r ]; then
        command docker run "${@:2}"
    elif [ "$1" = rn ]; then
        command docker run --name "${@:2}"
    elif [ "$1" = rnh ]; then
        command docker run --name "${@:2}" tail -f /dev/null
    elif [ "$1" = p ]; then 
        command docker ps "${@:2}"
    elif [ "$1" = pa ]; then 
        command docker ps -a "${@:2}"
    elif [ "$1" = sa ]; then
        command docker start "${@:2}"
    elif [ "$1" = sat ]; then
        command docker start "$2" && docker exec -it "${@:2}" 
    elif [ "$1" = sab ]; then
        command docker start "${@:2}" && docker exec -it "${@:2}" bash
    elif [ "$1" = saz ]; then
        command docker start "${@:2}" && docker exec -it "${@:2}" zsh
    elif [ "$1" = sp ]; then
        command docker stop "${@:2}"
    elif [ "$1" = rs ]; then
        command docker restart "${@:2}"
    elif [ "$1" = x ]; then
        command docker exec "${@:2}"
    elif [ "$1" = xt ]; then
        command docker exec -it "${@:2}"
    elif [ "$1" = xb ]; then
        command docker exec -it "${@:2}" bash
    elif [ "$1" = xz ]; then
        command docker exec -it "${@:2}" zsh
    elif [ "$1" = c ]; then
        command docker context "${@:2}"
    elif [ "$1" = cn ]; then
        command docker context create "${@:2}"
    elif [ "$1" = crm ]; then
        command docker context rm "${@:2}"
    elif [ "$1" = cl ]; then
        command docker context list "${@:2}"
    elif [ "$1" = cu ]; then
        command docker context use "${@:2}"
    elif [ "$1" = cud ]; then
        command docker context use default
    elif [ "$1" = cc ]; then
        command docker context show "${@:2}"
    elif [ "$1" = i ]; then
        command docker info "${@:2}"
    else
        command docker "$@"
    fi
}


################################################################
# # python
pi()
{
    if [ "$1" = a ]; then
        command tmux attach
    elif [ "$1" = i ]; then 
        command pip install "${@:2}"
    elif [ "$1" = n ]; then 
        command pip install "${@:2}"
    elif [ "$1" = rm ]; then 
        command pip uninstall "${@:2}"
    elif [ "$1" = l ]; then 
        command pip list "${@:2}"
    else
        command pip "$@"
    fi
}

alias py='python'
alias ipy='ipython'


################################################################
# # anaconda
if [ -z "${CONDA_HOME}" ]; then
    export CONDA_HOME="$APP_HOME/anaconda3"
fi

cni()
{
    __conda_setup="$('$CONDA_HOME/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "$CONDA_HOME/etc/profile.d/conda.sh" ]; then
            . "$CONDA_HOME/etc/profile.d/conda.sh"
        else
            export PATH="$CONDA_HOME/bin:$PATH"
        fi
    fi
    unset __conda_setup
}

cn()
{   if [ "$1" = av ]; then
        conda activate "${@:2}"
    elif [ "$1" = dv ]; then
        conda deactivate
    elif [ "$1" = l ]; then
        command conda env list
    elif [ "$1" = n ]; then
        command conda create "${@:2}"
    elif [ "$1" = nn ]; then
        command conda create -n "$2" "${@:3}" python
    elif [ "$1" = nnp ]; then
        command conda create -n "$2" "${@:4}" python="$3"
    elif [ "$1" = rm ]; then
        command conda env remove -n "${@:2}"
    else
        command conda "$@"
    fi
}

alias cav='cn av'
alias cdv='cn dv'

cni


################################################################
# # sudo
sudoenv() {
    if [ $# -eq 0 ]; then
        echo "Usage: sudoenv <command> [args...]" >&2
        return 1
    fi
  
    sudo bash -c "shopt -s expand_aliases;
        source \"$SHRC_PATH\";eval \"\$@\"
    " "sudoenv" "$@"
}


################################################################
# # find file by name precisely
ff()
{   
    if [ $# = 0 ]; then
        echo "Usage: ff [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command find . -name $1 2> /dev/null
    else
        command find $1 -name $2 2> /dev/null
    fi
}
# # find file by name roughly
ffa()
{   
    if [ $# = 0 ]; then
        echo "Usage: ffa [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command find . -iname \*$1\* 2> /dev/null
    else
        command find $1 -iname \*$2\* 2> /dev/null
    fi
}
# # find text of word
fx()
{  
    if [ $# = 0 ]; then
        echo "Usage: fx [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command grep -rnw . -e $1 --color=auto
    else
        command grep -rnw $1 -e $2 --color=auto ${@:3}
    fi
    
}
# # find text of all
fxa() 
{
    if [ $# = 0 ]; then
        echo "Usage: fxa [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command grep -rni . -e $1 --color=auto
    else
        command grep -rni $1 -e $2 --color=auto ${@:3}
    fi
}


################################################################
# # function
contains() {
    string="$1"
    substring="$2"
    if test "${string#*$substring}" != "$string"
    then
        return 0 
    else
        return 1
    fi
}

################################################################
# # settings
ulimit -n 65536


################################################################
# # shrc
_shrc_SHELL_rc_path()
{
    echo "${HOME}/."$(basename $SHELL)"rc"
}

_shrc_SHELL_history_path()
{
    echo "${HOME}/."$(basename $SHELL)"_history"
}

# clear history
_shrc_SHELL_clear_history()
{   
    echo "Clear history: $(_shrc_SHELL_history_path)"
    command rm $(_shrc_SHELL_history_path)
}

# # source .shrc
_shrc_source_shrc()
{   
    command echo "Current shell: $SHELL"
    . $(_shrc_SHELL_rc_path)
}

# # update .shrc
_shrc_update_shrc()
{
    command curl https://gitee.com/kurayuri/shrc/raw/main/.shrc -o ${HOME}/.shrc_new
    if [ $? = 0 ]; then
        . ${HOME}/.shrc_new
        if [ $? = 0 ]; then
            command rm $SHRC_PATH
            command mv ${HOME}/.shrc_new $SHRC_PATH
        else
            command rm ${HOME}/.shrc_new
        fi
    else
        command rm ${HOME}/.shrc_new
    fi
    _shrc_source_shrc
}

# # edit .shrc
_shrc_edit_shrc()
{
    vim $SHRC_PATH
}

# # view .shrc
_shrc_view_shrc()
{
    command cat $SHRC_PATH
} 

_shrc_update_script()
{
    if [ $# = 0 ]; then
        echo "Usage: ush <script_name>"
    else
        command curl https://gitee.com/kurayuri/scripts/raw/main/$1 -o $SHRC_SCRIPTS_HOME/$1.sh
        if [ $? = 0 ]; then
            command chmod +x $1.sh
        fi
    fi
}

_shrc_run_script()
{
    # TODO
    if [ $# = 0 ]; then
        echo "Usage: ush <script_name>"
    else
        command $SHRC_SCRIPTS_HOME/$1.sh
    fi
}

shrc()
{
    if [ $# = 0 ]; then
        echo "Usage: shrc <script_name>"
        return
    fi
    if [ "$1" = update ]; then 
        _shrc_update_shrc ${@:2}
    elif [ "$1" = source ]; then
        _shrc_source_shrc ${@:2}
    elif [ "$1" = edit ]; then
        _shrc_edit_shrc ${@:2}
    elif [ "$1" = view ]; then
        _shrc_view_shrc ${@:2}
    elif [ "$1" = install ]; then
        _shrc_update_script ${@:2}
    elif [ "$1" = run ]; then
        _shrc_update_script ${@:2}
    elif [ "$1" = clear ]; then
        _shrc_SHELL_clear_history ${@:2}
    else
        echo "Unknown command: $1"
        echo "Usage: shrc <command> [<args>]"
        echo "Available commands: source, update, edit, view, install, run, clear"
    fi    
}



alias src='shrc source'
alias urc='shrc update'
alias erc='shrc edit'
alias vrc='shrc view'
alias ish='shrc install'
alias rsh='shrc run'
alias csh='shrc clear'
################################################################