################################################################
# # Unix Shell Run Commands
################################################################


################################################################
# # Command Naming Standard
# n     : Create new            | sa    : Start
## n    : with name             

# rm    : Remove                | sp    : Stop
##  a   : all

# l     : List                  | p     : Process Status
## a    : all

# x     : Execute


################################################################
# # environment variables

SHRC_PATH="$HOME/.shrc"
SHRC_SCRIPTS_HOME="$HOME/.shrc_scripts"

export APP_HOME="$HOME/Application"
export LOCAL_HOME="$HOME/.local"
export BUN_HOME="$HOME/.bun"
export ELAN_HOME="$HOME/.elan"
export CUDA_HOME="/usr/local/cuda"

export GUROBI_VERSION=${GUROBI_VERSION:-"1203"}
export GUROBI_GPU=${GUROBI_GPU:-""}
export GUROBI_HOME=${GUROBI_HOME:-"$APP_HOME/gurobi/gurobi$GUROBI_VERSION/linux64${GUROBI_GPU}"}

export PATH="$APP_HOME/bin:$LOCAL_HOME/bin:$BUN_HOME/bin:$ELAN_HOME/bin:$CUDA_HOME/bin:$GUROBI_HOME/bin:$NVM_BIN;$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib64:$GUROBI_HOME/lib:$LD_LIBRARY_PATH"


################################################################
