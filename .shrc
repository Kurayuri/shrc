################################################################
# # Unix Shell Run Commands
################################################################


################################################################
# # Command Naming Standard
# n     : Create new            | sa    : Start
## n    : with name             

# rm    : Remove                | sp    : Stop
##  a   : all

# l     : List                  | p     : Process Status
## a    : all

# x     : Execute


################################################################
# # Shortcut
alias cls='clear'

alias du0="du -s   -h | sort -h"
alias du1="du -d 1 -h | sort -h"

alias h="history"

alias wa='watch -n 0.1'
alias wanv="wa nvidia-smi"

alias pa='ps aux'
alias runner="ps aux | awk '{print \$1}' | sort | uniq"


################################################################
# # global alias
if [[ -n "$ZSH_VERSION" ]]; then
    alias -g H='| head'
    alias -g T='| tail'
    alias -g G='| grep'
fi


################################################################
# # suffix alias
if [[ -n "$ZSH_VERSION" ]]; then
    alias -s deb="dpkg -i"
    alias -s gz="tar -zxvf"
    alias -s tar="tar -xvf"
    alias -s tgz="tar -zxvf"
    alias -s zip="unzip"
fi


################################################################
# # environment variables
SHRC_SCRIPTS_HOME="$HOME/.shrc_scripts"

export APP_HOME="$HOME/Application"
export LOCAL_HOME="$HOME/.local"
export BUN_HOME="$HOME/.bun"
export ELAN_HOME="$HOME/.elan"
export CUDA_HOME="/usr/local/cuda"

export PATH="$APP_HOME/bin:$LOCAL_HOME/bin:$BUN_HOME/bin:$ELAN_HOME/bin:$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

################################################################
# # mirrors
export HF_ENDPOINT='https://hf-mirror.com'

################################################################
# # venv
alias av='source ./bin/activate'
alias dv='deactivate'

################################################################
# # ssh
tscp()
{
    src=$1
    remote=$2
    dst=$3
    tar cf - $src | ssh $remote "tar xf - -C $dst"
}

################################################################
# # Proxy
# export host_ip=$(cat /etc/resolv.conf |grep "nameserver"|head -1 |cut -f 2 -d " ")

proxy()
{
    local ip="localhost"
    local port=7890
    local protocal="http"
    if [ $# = 1 ]; then
        ip=$1
    elif [ $# = 2 ]; then
        ip=$1
        port=$2
    elif [ $# = 3 ]; then
        ip=$1
        port=$2
        protocal=$3
    fi
    export all_proxy="${protocal}://${ip}:${port}" http_proxy="${protocal}://${ip}:${port}" https_proxy="${protocal}://${ip}:${port}" socks_proxy="${protocal}://${ip}:${port}"
    export ALL_PROXY="${protocal}://${ip}:${port}" HTTP_PROXY="${protocal}://${ip}:${port}" HTTPS_PROXY="${protocal}://${ip}:${port}" SOCKS_PROXY="${protocal}://${ip}:${port}"
}
alias unproxy='unset all_proxy http_proxy https_proxy socks_proxy ALL_PROXY HTTP_PROXY HTTPS_PROXY SOCKS_PROXY'
# proxy

################################################################
# # network
alias ic="ifconfig"

ns()
{   
    if [ $# = 0 ]; then
        command netstat -anp
    elif [ $# = 1 ]; then
        command netstat -anp | grep $1
    fi
}


nst()
{   
    if [ $# = 0 ]; then
        command netstat -anpt
    elif [ $# = 1 ]; then
        command netstat -anpt | grep $1
    fi
}

nsu()
{   
    if [ $# = 0 ]; then
        command netstat -anpu
    elif [ $# = 1 ]; then
        command netstat -anpu | grep $1
    fi
}

alias tgit="ssh -vT git@github.com"
alias tnet="ping -c 4 jd.com"
alias tweb="curl jd.com"
alias tprx="curl www.google.com"

################################################################
# # ssh-agent
ssa()
{
    eval "$(ssh-agent -s)"
    cd ~/.ssh
    ssh-add *id*
    cd ~
}
# ssa


################################################################
# # tmux
tx()
{
    if [ "$1" = a ]; then
        command tmux attach
    elif [ "$1" = at ]; then
        command tmux attach -t "${@:2}"
    elif [ "$1" = cl  ]; then
        command tmux clear-history
    elif [ "$1" = cls ]; then
        command clear
        command tmux clear-history
    elif [ "$1" = l ]; then 
        command tmux ls "${@:2}"
    elif [ "$1" = n ]; then 
        command tmux
    elif [ "$1" = nn ]; then 
        command tmux new -s "${@:2}"
    elif [ "$1" = rm ]; then 
        command tmux kill-session -t "${@:2}"
    elif [ "$1" = rma ]; then 
        command tmux kill-session -a "${@:2}"
    elif [ "$1" = s ]; then 
        if [ $# = 1 ]; then
            command tmux capture-pane -pS - > "tmux.log"
        elif [ $# = 2 ]; then
            command tmux capture-pane -pS - > "$2"
        fi
    else
        command tmux "$@"
    fi
}

TMUX_CONF='set -g history-limit 1048576
bind C-l send-keys C-l \; clear-history
bind C-s capture-pane -S -  \; save-buffer tmux.log'
echo $TMUX_CONF > $HOME/.tmux.conf


################################################################\
# # docker
dk()
{

    if [ "$1" = l ]; then 
        command docker image list "${@:2}"
    elif [ "$1" = n ]; then
        command docker create "${@:2}"
    elif [ "$1" = nn ]; then
        command docker create --name "${@:2}"
    elif [ "$1" = nnh ]; then
        command docker create --name "${@:2}" tail -f /dev/null
    elif [ "$1" = r ]; then
        command docker run "${@:2}"
    elif [ "$1" = rn ]; then
        command docker run --name "${@:2}"
    elif [ "$1" = rnh ]; then
        command docker run --name "${@:2}" tail -f /dev/null
    elif [ "$1" = p ]; then 
        command docker ps "${@:2}"
    elif [ "$1" = pa ]; then 
        command docker ps -a "${@:2}"
    elif [ "$1" = sa ]; then
        command docker start "${@:2}"
    elif [ "$1" = sat ]; then
        command docker start "$2" && docker exec -it "${@:2}" 
    elif [ "$1" = sab ]; then
        command docker start "${@:2}" && docker exec -it "${@:2}" bash
    elif [ "$1" = sp ]; then
        command docker stop "${@:2}"
    elif [ "$1" = x ]; then
        command docker exec "${@:2}"
    elif [ "$1" = xt ]; then
        command docker exec -it "${@:2}"
    elif [ "$1" = xb ]; then
        command docker exec -it "${@:2}" bash
    elif [ "$1" = c ]; then
        command docker context "${@:2}"
    elif [ "$1" = cn ]; then
        command docker context create "${@:2}"
    elif [ "$1" = crm ]; then
        command docker context rm "${@:2}"
    elif [ "$1" = cl ]; then
        command docker context list "${@:2}"
    elif [ "$1" = cu ]; then
        command docker context use "${@:2}"
    elif [ "$1" = cud ]; then
        command docker context use default
    elif [ "$1" = cc ]; then
        command docker context show "${@:2}"
    elif [ "$1" = i ]; then
        command docker info "${@:2}"
    else
        command docker "$@"
    fi
}


################################################################
# # python
pi()
{
    if [ "$1" = a ]; then
        command tmux attach
    elif [ "$1" = i ]; then 
        command pip install "${@:2}"
    elif [ "$1" = n ]; then 
        command pip install "${@:2}"
    elif [ "$1" = rm ]; then 
        command pip uninstall "${@:2}"
    elif [ "$1" = l ]; then 
        command pip list "${@:2}"
    else
        command pip "$@"
    fi
}

alias py='python'
alias ipy='ipython'


################################################################
# # anaconda
if [ -z "${CONDA_HOME}" ]; then
    export CONDA_HOME="$APP_HOME/anaconda3"
fi

cni()
{
    __conda_setup="$('$CONDA_HOME/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "$CONDA_HOME/etc/profile.d/conda.sh" ]; then
            . "$CONDA_HOME/etc/profile.d/conda.sh"
        else
            export PATH="$CONDA_HOME/bin:$PATH"
        fi
    fi
    unset __conda_setup
}

cn()
{   if [ "$1" = av ]; then
        conda activate "${@:2}"
    elif [ "$1" = dv ]; then
        conda deactivate
    elif [ "$1" = l ]; then
        command conda env list
    elif [ "$1" = n ]; then
        command conda create "${@:2}"
    elif [ "$1" = nn ]; then
        command conda create -n "$2" "${@:3}" python
    elif [ "$1" = nnp ]; then
        command conda create -n "$2" "${@:4}" python="$3"
    elif [ "$1" = rm ]; then
        command conda env remove -n "${@:2}"
    else
        command conda "$@"
    fi
}

alias cav='cn av'
alias cdv='cn dv'

cni



################################################################
# # find file by name precisely
ff()
{   
    if [ $# = 0 ]; then
        echo "Usage: ff [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command find . -name $1 2> /dev/null
    else
        command find $1 -name $2 2> /dev/null
    fi
}
# # find file by name roughly
ffa()
{   
    if [ $# = 0 ]; then
        echo "Usage: ffa [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command find . -iname \*$1\* 2> /dev/null
    else
        command find $1 -iname \*$2\* 2> /dev/null
    fi
}
# # find text of word
fx()
{  
    if [ $# = 0 ]; then
        echo "Usage: fx [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command grep -rnw . -e $1 --color=auto
    else
        command grep -rnw $1 -e $2 --color=auto ${@:3}
    fi
    
}
# # find text of all
fxa() 
{
    if [ $# = 0 ]; then
        echo "Usage: fxa [<path>] <pattern>"
    elif [ $# = 1 ]; then
        command grep -rni . -e $1 --color=auto
    else
        command grep -rni $1 -e $2 --color=auto ${@:3}
    fi
}


################################################################
# # function
contains() {
    string="$1"
    substring="$2"
    if test "${string#*$substring}" != "$string"
    then
        return 0 
    else
        return 1
    fi
}

################################################################
# # settings
ulimit -n 65536


################################################################
# # source .shrc
_shrc_source_shrc()
{   
    command echo "Current shell: $SHELL"
    . ~/."$(basename $SHELL)"rc
}

# # update .shrc
_shrc_update_shrc()
{
    command curl https://gitee.com/kurayuri/shrc/raw/main/.shrc -o ~/.shrc_new
    if [ $? = 0 ]; then
        . ~/.shrc_new
        if [ $? = 0 ]; then
            command rm ~/.shrc
            command mv ~/.shrc_new ~/.shrc
        else
            command rm ~/.shrc_new
        fi
    else
        command rm ~/.shrc_new
    fi
    _shrc_source_shrc
}

_shrc_update_script()
{
    if [ $# = 0 ]; then
        echo "Usage: ush <script_name>"
    else
        command curl https://gitee.com/kurayuri/scripts/raw/main/$1 -o $SHRC_SCRIPTS_HOME/$1.sh
        if [ $? = 0 ]; then
            command chmod +x $1.sh
        fi
    fi
}

_shrc_run_script()
{
    # TODO
    if [ $# = 0 ]; then
        echo "Usage: ush <script_name>"
    else
        command $SHRC_SCRIPTS_HOME/$1.sh
    fi
}

shrc()
{
    if [ $# = 0 ]; then
        echo "Usage: shrc <script_name>"
        return
    fi
    if [ "$1" = update ]; then 
        _shrc_update_shrc ${@:2}
    elif [ "$1" = source ]; then
        _shrc_source_shrc ${@:2}
    elif [ "$1" = install ]; then
        _shrc_update_script ${@:2}
    elif [ "$1" = run ]; then
        _shrc_update_script ${@:2}
    fi    
}



alias src='shrc source'
alias urc='shrc update'
alias ish='shrc install'
alias rsh='shrc run'
################################################################